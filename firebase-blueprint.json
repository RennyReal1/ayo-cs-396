{
  "entities": {
    "Snapshot": {
      "title": "Marketing Period Snapshot",
      "description": "Historical benchmark snapshot for period-over-period comparison (e.g. Q4 vs Q3, Monthly)",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the snapshot e.g. Q4 Holiday Blitz 2025"
        },
        "periodLabel": {
          "type": "string",
          "description": "Date range label e.g. Oct 1 – Dec 31, 2025"
        },
        "totalUsers": {
          "type": "number",
          "description": "Total users in snapshot"
        },
        "totalConversions": {
          "type": "number",
          "description": "Total conversions"
        },
        "conversionRate": {
          "type": "number",
          "description": "Conversion rate percentage"
        },
        "totalRevenue": {
          "type": "number",
          "description": "Total revenue in USD"
        },
        "avgJourneyLength": {
          "type": "number",
          "description": "Average touchpoints per user"
        },
        "topChannel": {
          "type": "string",
          "description": "Top performing channel"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["name", "periodLabel", "totalUsers", "totalConversions", "conversionRate", "totalRevenue", "avgJourneyLength", "topChannel", "createdAt"]
    },
    "Touchpoint": {
      "title": "Customer Journey Touchpoint",
      "description": "An interaction touchpoint in a marketing path to conversion",
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string",
          "description": "Identifier of the prospective customer"
        },
        "channel": {
          "type": "string",
          "description": "Marketing channel where interaction occurred",
          "enum": ["Search", "YouTube", "Display", "Discover", "Gmail", "Direct"]
        },
        "interaction_sequence": {
          "type": "number",
          "description": "Order of interaction in user journey starting at 1"
        },
        "converted": {
          "type": "boolean",
          "description": "Whether this touchpoint resulted in a conversion event"
        },
        "conversion_value_usd": {
          "type": "number",
          "description": "Monetary value of conversion if converted is true, otherwise 0"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of touchpoint"
        }
      },
      "required": ["user_id", "channel", "interaction_sequence", "converted", "conversion_value_usd", "timestamp"]
    }
  },
  "firestore": {
    "/p2c_snapshots/{snapshotId}": {
      "schema": "Snapshot",
      "description": "Snapshots collection storing period-over-period marketing benchmarks"
    },
    "/p2c_touchpoints/{touchpointId}": {
      "schema": "Touchpoint",
      "description": "Touchpoints collection storing multi-channel journey events"
    }
  }
}
